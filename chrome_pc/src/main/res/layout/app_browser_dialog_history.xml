<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ui_browser_bg_settings"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ui_browser_ic_history_14"
            app:tint="@color/text_default" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/browser_menu_history"
            android:textColor="@color/text_default"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnClearHistory"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/ui_browser_btn_subtle"
            android:paddingHorizontal="10dp"
            android:text="Clear History"
            android:textAllCaps="false"
            android:textColor="#ff5252"
            android:textSize="12sp" />
    </LinearLayout>

    <EditText
        android:id="@+id/etHistorySearch"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/ui_browser_edittext_search"
        android:drawableStart="@drawable/ui_browser_ic_search_18"
        android:drawablePadding="8dp"
        android:hint="@string/history_search_hint"
        android:imeOptions="actionDone"
        android:inputType="text"
        android:maxLines="1"
        android:paddingHorizontal="10dp"
        android:textColor="@color/text_default"
        android:textColorHint="@color/text_muted"
        android:textSize="13sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:layout_marginTop="12dp"
        android:background="#18181b">

        <ScrollView
            android:id="@+id/svHistoryContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/historyListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="4dp" />
        </ScrollView>

        <TextView
            android:id="@+id/tvHistoryEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/history_empty"
            android:textColor="@color/text_muted"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>

    <Button
        android:id="@+id/btnCloseHistory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/ui_browser_btn_nav"
        android:text="@string/btn_ok"
        android:textAllCaps="false"
        android:textColor="@color/text_default"
        android:textSize="14sp" />

</LinearLayout>
