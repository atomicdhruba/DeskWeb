<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="8dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">
        <ImageButton
            android:id="@+id/btnBack"
            android:background="@drawable/ui_browser_btn_nav"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ui_browser_ic_nav_left_20"
            android:contentDescription="@string/nav_go_back"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_default"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/context_menu_zoom"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/ui_browser_bg_settings_card"
        android:padding="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageButton
            android:id="@+id/btn_zoom_minus"
            android:background="@drawable/ui_browser_btn_secondary"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_chevron_down_20_filled"
            android:contentDescription="Zoom Out"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/text_default"
            android:gravity="center"
            android:id="@+id/zoom_value_text"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:text="100%"/>
        <ImageButton
            android:id="@+id/btn_zoom_plus"
            android:background="@drawable/ui_browser_btn_secondary"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_chevron_up_20_filled"
            android:contentDescription="Zoom In"/>
        <ImageButton
            android:id="@+id/btn_zoom_reset"
            android:background="@drawable/ui_browser_btn_secondary"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ui_browser_ic_reload_20"
            android:contentDescription="Reset"
            android:layout_marginStart="6dp"/>
        <ImageButton
            android:id="@+id/btn_zoom_fullscreen"
            android:background="@drawable/ui_browser_btn_secondary"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_fullscreen_24"
            android:contentDescription="Full screen (F11)"
            android:layout_marginStart="6dp"/>
    </LinearLayout>
</LinearLayout>
