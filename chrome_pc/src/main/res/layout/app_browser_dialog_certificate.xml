<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ui_browser_bg_settings"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivCertStatusIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/ic_lock_24"
            app:tint="#4caf50" />

        <TextView
            android:id="@+id/tvCertTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cert_title"
            android:textColor="@color/text_default"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvCertStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#4caf50"
        android:textSize="14sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginTop="12dp"
        android:background="#18181b"
        android:padding="10dp">

        <TextView
            android:id="@+id/tvCertDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/text_default"
            android:textSize="12sp" />
    </ScrollView>

    <Button
        android:id="@+id/btnCloseCert"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/ui_browser_btn_nav"
        android:text="@string/btn_ok"
        android:textAllCaps="false"
        android:textColor="@color/text_default"
        android:textSize="14sp" />

</LinearLayout>
