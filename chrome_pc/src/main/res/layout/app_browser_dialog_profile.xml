<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/ui_browser_bg_dialog"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    android:elevation="12dp">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <TextView
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/activeAvatarBadge"
            android:background="@drawable/ui_browser_circle_avatar"
            android:layout_width="48dp"
            android:layout_height="48dp"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_default"
            android:id="@+id/activeProfileName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Personal"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/text_muted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Current Profile"/>
    </LinearLayout>
    <View
        android:background="@color/ui_card_border"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/text_muted"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Profiles"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/profileListContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <View
        android:background="@color/ui_card_border"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/btnAddProfile"
        android:background="@drawable/ui_browser_btn_subtle"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ui_browser_ic_add_regular"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/text_default"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Profile"
            android:layout_marginStart="12dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/btnGuestMode"
        android:background="@drawable/ui_browser_btn_subtle"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <TextView
            android:textSize="18sp"
            android:text="🕶️"
            android:gravity="center"
            android:layout_width="24dp"
            android:layout_height="24dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/text_default"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Guest Mode"
            android:layout_marginStart="12dp"/>
    </LinearLayout>
</LinearLayout>
