<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/ui_browser_tab_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="8dp"
    android:paddingEnd="4dp"
    android:layout_marginStart="4dp">
    <TextView
        android:textSize="13sp"
        android:textColor="@color/text_default"
        android:ellipsize="end"
        android:id="@+id/tabTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="125dp"
        android:text="@string/browser_tab_new"
        android:maxLines="1"
        android:singleLine="true"
        android:drawablePadding="6dp"
        android:layout_centerVertical="true"
        android:layout_toStartOf="@+id/btn_close_tab"
        android:layout_alignParentStart="true"
        app:drawableStartCompat="@drawable/ui_browser_icon_tint"/>
    <ProgressBar
        android:id="@+id/spinner"
        android:background="@drawable/ui_browser_tab_progress_bg"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:layout_centerVertical="true"
        android:indeterminateTint="@color/ui_browser_ui_tint"
        style="?android:attr/progressBarStyleSmall"/>
    <ImageButton
        android:id="@+id/btn_close_tab"
        android:background="@drawable/ui_browser_btn_nav"
        android:padding="5dp"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ui_browser_ic_close"
        android:scaleType="centerInside"
        android:layout_centerVertical="true"
        android:contentDescription="@string/browser_tab_close"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
