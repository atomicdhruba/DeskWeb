<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/ui_browser_bg_settings"
    android:paddingLeft="10dp"
    android:paddingTop="8dp"
    android:paddingRight="10dp"
    android:paddingBottom="8dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="10dp"
    android:elevation="8dp"
    android:paddingHorizontal="10dp"
    android:paddingVertical="8dp">
    <EditText
        android:textSize="12sp"
        android:id="@+id/edit_app_name"
        android:background="@android:color/transparent"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="146dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:scrollHorizontally="true"
        android:paddingStart="6dp"
        android:paddingEnd="0dp"
        android:layout_marginEnd="4dp"
        android:paddingVertical="10dp"
        android:autofillHints="@null"/>
    <ImageButton
        android:id="@+id/btn_prev"
        android:background="@drawable/ui_browser_btn_nav"
        android:padding="6dp"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_chevron_up_20_filled"
        android:scaleType="centerInside"/>
    <ImageButton
        android:id="@+id/btn_next"
        android:background="@drawable/ui_browser_btn_nav"
        android:padding="6dp"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_chevron_down_20_filled"
        android:scaleType="centerInside"/>
    <ImageButton
        android:id="@+id/btn_close"
        android:background="@drawable/ui_browser_btn_nav"
        android:padding="6dp"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/app_title_ic_close_16"
        android:scaleType="centerInside"/>
</LinearLayout>
