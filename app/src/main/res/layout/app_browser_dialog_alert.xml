<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/ui_browser_bg_dialog"
    android:padding="20dp"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:id="@+id/dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Leave Site?"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/text_muted"
        android:id="@+id/dialog_subtitle"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:maxWidth="220dp"
        android:text="Changes you made may not be saved."
        android:layout_below="@+id/dialog_title"
        android:paddingVertical="8dp"/>
    <Button
        android:textSize="13sp"
        android:textColor="@color/color_scheme_ui"
        android:id="@+id/btn_install"
        android:background="@drawable/ui_browser_btn_negative"
        android:paddingLeft="16dp"
        android:paddingTop="8dp"
        android:paddingRight="16dp"
        android:paddingBottom="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:text="Leave"
        android:layout_below="@+id/dialog_subtitle"
        android:textAllCaps="false"
        android:layout_marginEnd="8dp"
        android:layout_toStartOf="@+id/btn_cancel"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"/>
    <Button
        android:textSize="13sp"
        android:textColor="@color/ui_browser_txt_primary"
        android:id="@+id/btn_cancel"
        android:background="@drawable/ui_browser_btn_primary"
        android:paddingLeft="16dp"
        android:paddingTop="8dp"
        android:paddingRight="16dp"
        android:paddingBottom="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:text="@string/dialog_actions_cancel"
        android:layout_below="@+id/dialog_subtitle"
        android:textAllCaps="false"
        android:layout_toEndOf="@+id/dialog_subtitle"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"/>
</RelativeLayout>
