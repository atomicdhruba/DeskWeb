<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ui_browser_bg_settings"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvCookiesTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/browser_menu_cookies"
        android:textColor="@color/text_default"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvCookiesDomain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/text_muted"
        android:textSize="13sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginTop="8dp"
        android:background="#18181b"
        android:padding="8dp">

        <TextView
            android:id="@+id/tvCookiesContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_default"
            android:textSize="12sp"
            android:fontFamily="monospace" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnClearSiteCookies"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/ui_browser_btn_subtle"
            android:text="Clear Site Data"
            android:textAllCaps="false"
            android:textColor="@color/text_default"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnClearAllCookies"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/ui_browser_btn_subtle"
            android:text="Clear All Cookies"
            android:textAllCaps="false"
            android:textColor="#ff5252"
            android:textSize="13sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnCloseCookies"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/ui_browser_btn_nav"
        android:text="@string/btn_ok"
        android:textAllCaps="false"
        android:textColor="@color/text_default"
        android:textSize="14sp" />

</LinearLayout>
