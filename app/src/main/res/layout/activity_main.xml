<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/main_root"
    android:background="@color/ui_browser_settings_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/titleBar"
        android:background="@color/ui_browser_titlebar_bg"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">
        <com.pcbrowser.chrome.ui.widgets.MaxWidthHorizontalScrollView
            android:id="@+id/tabScrollView"
            android:scrollbars="none"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <LinearLayout
                android:gravity="bottom"
                android:orientation="horizontal"
                android:id="@+id/tabStrip"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"/>
        </com.pcbrowser.chrome.ui.widgets.MaxWidthHorizontalScrollView>
        <ImageButton
            android:id="@+id/btn_new_tab"
            android:background="@drawable/ui_browser_btn_primary_ripple"
            android:padding="7dp"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ui_browser_ic_add_regular"
            android:contentDescription="@string/browser_tab_new"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/toolbar"
        android:background="@color/ui_browser_toolbar_bg"
        android:paddingLeft="6dp"
        android:paddingTop="6dp"
        android:paddingRight="6dp"
        android:paddingBottom="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="6dp"
        android:paddingVertical="6dp">
        <ImageButton
            android:id="@+id/btn_back"
            android:background="@drawable/ui_browser_btn_nav"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@drawable/ui_browser_ic_nav_left_20"
            android:contentDescription="@string/nav_go_back"/>
        <ImageButton
            android:id="@+id/btn_fwd"
            android:background="@drawable/ui_browser_btn_nav"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@drawable/ui_browser_ic_nav_right_18"
            android:contentDescription="@string/nav_go_forward"/>
        <ImageButton
            android:id="@+id/btn_reload"
            android:background="@drawable/ui_browser_btn_nav"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@drawable/ui_browser_ic_reload_20"
            android:contentDescription="@string/nav_reload"/>
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="6dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="6dp">
            <com.pcbrowser.chrome.ui.widgets.AddressBarView
                android:textSize="14sp"
                android:textColor="@color/text_default"
                android:textColorHint="@color/text_muted"
                android:ellipsize="end"
                android:id="@+id/addressBar"
                android:background="@drawable/ui_browser_edittext_search"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="@string/browser_search_hint"
                android:maxLines="1"
                android:drawablePadding="8dp"
                android:completionThreshold="1"
                android:inputType="textUri"
                android:imeOptions="flagNoExtractUi|flagNoFullscreen|actionGo"
                android:dropDownHeight="wrap_content"
                android:dropDownVerticalOffset="8dp"
                android:drawableStart="@drawable/ui_browser_ic_google"
                android:paddingStart="10dp"
                android:paddingEnd="72dp"
                android:importantForAutofill="yes"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_gravity="end|center_vertical"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp">
                <ImageButton
                    android:id="@+id/btn_clear_address"
                    android:background="@drawable/ui_browser_btn_nav"
                    android:padding="6dp"
                    android:visibility="gone"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ui_browser_ic_close"
                    android:contentDescription="Clear"/>
                <ImageButton
                    android:id="@+id/btn_bookmark_star"
                    android:background="@drawable/ui_browser_btn_nav"
                    android:padding="5dp"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_bookmark_star_24"
                    android:contentDescription="Bookmark this tab"/>
            </LinearLayout>
        </FrameLayout>
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/btn_profile"
            android:background="@drawable/ui_browser_circle_avatar"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginLeft="3dp"
            android:layout_marginRight="3dp"
            android:text="P"
            android:contentDescription="Switch Profile"
            android:layout_marginHorizontal="3dp"/>
        <ImageButton
            android:id="@+id/btn_downloads"
            android:background="@drawable/ui_browser_btn_nav"
            android:padding="6dp"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp"
            android:src="@drawable/ui_browser_ic_downloads"
            android:scaleType="centerCrop"
            android:contentDescription="@string/context_menu_downloads"
            android:layout_marginHorizontal="2dp"/>
        <ImageButton
            android:id="@+id/btn_keyboard_toggle"
            android:background="@drawable/ui_browser_btn_nav"
            android:padding="6dp"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp"
            android:src="@drawable/ic_keyboard_black_24dp"
            android:scaleType="fitCenter"
            android:contentDescription="Toggle Virtual Keyboard"
            android:layout_marginHorizontal="2dp"/>
        <ImageButton
            android:id="@+id/btn_menu"
            android:background="@drawable/ui_browser_btn_nav"
            android:padding="6dp"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@drawable/ui_browser_ic_devices_18"
            android:contentDescription="@string/nav_settings"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/bookmarksBar"
        android:background="@color/ui_browser_toolbar_bg"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">
        <HorizontalScrollView
            android:scrollbars="none"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/bookmarksContainer"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"/>
        </HorizontalScrollView>
        <ImageButton
            android:id="@+id/btn_add_bookmark"
            android:background="@drawable/ui_browser_btn_nav"
            android:padding="5dp"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ui_browser_ic_add_regular"
            android:contentDescription="Add Bookmark"/>
    </LinearLayout>
    <View
        android:id="@+id/bookmarksDivider"
        android:background="@color/ui_card_border"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <ProgressBar
        android:id="@+id/pageProgressBar"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:max="100"
        android:indeterminate="false"
        android:progressDrawable="@color/ui_browser_ui_tint"
        style="?android:attr/progressBarStyleHorizontal"/>
    <FrameLayout
        android:id="@+id/contentFrame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <FrameLayout
            android:id="@+id/tabContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/fullscreenCustomViewContainer"
            android:background="#000000"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:layout_gravity="end|top"
            android:id="@+id/overlay_container"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="12dp"
            android:elevation="12dp"/>
        <LinearLayout
            android:id="@+id/btnExitFullscreen"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/ui_browser_bg_exit_fullscreen"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true"
            android:layout_gravity="top|end"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:elevation="14dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:src="@drawable/ic_fullscreen_exit_24"
                android:layout_width="18dp"
                android:layout_height="18dp"/>
            <TextView
                android:text="@string/browser_exit_fullscreen"
                android:textColor="#ffffff"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginStart="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
