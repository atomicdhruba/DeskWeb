<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/ui_browser_bg_dialog"
    android:padding="20dp"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:id="@+id/dialog_title"
        android:paddingBottom="18dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/browser_installer_title"/>
    <ImageView
        android:id="@+id/app_icon"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:src="@drawable/img_app_deskweb"
        android:layout_below="@+id/dialog_title"
        android:contentDescription="@null"
        android:layout_marginEnd="16dp"
        android:layout_alignParentStart="true"/>
    <EditText
        android:textSize="14sp"
        android:ellipsize="end"
        android:id="@+id/edit_app_name"
        android:background="@drawable/ui_browser_edittext_search"
        android:paddingLeft="14dp"
        android:paddingTop="8dp"
        android:paddingRight="14dp"
        android:paddingBottom="8dp"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:hint="@string/settings_accounts_name_update_hint"
        android:maxLines="1"
        android:scrollHorizontally="true"
        android:layout_alignTop="@+id/app_icon"
        android:inputType="text"
        android:layout_toEndOf="@+id/app_icon"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"/>
    <TextView
        android:textSize="13sp"
        android:ellipsize="end"
        android:id="@+id/url_text"
        android:padding="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:maxWidth="210dp"
        android:text="www.website.com"
        android:maxLines="1"
        android:layout_below="@+id/edit_app_name"
        android:layout_alignStart="@+id/edit_app_name"/>
    <Button
        android:textSize="13sp"
        android:textColor="@color/ui_browser_txt_primary"
        android:id="@+id/btn_install"
        android:background="@drawable/ui_browser_btn_primary"
        android:paddingLeft="16dp"
        android:paddingTop="8dp"
        android:paddingRight="16dp"
        android:paddingBottom="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:text="@string/app_installer_btn_install"
        android:layout_below="@+id/url_text"
        android:textAllCaps="false"
        android:layout_marginEnd="8dp"
        android:layout_toStartOf="@+id/btn_cancel"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"/>
    <Button
        android:textSize="13sp"
        android:textColor="@color/color_scheme_ui"
        android:id="@+id/btn_cancel"
        android:background="@drawable/ui_browser_btn_negative"
        android:paddingLeft="16dp"
        android:paddingTop="8dp"
        android:paddingRight="16dp"
        android:paddingBottom="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:text="@string/dialog_actions_cancel"
        android:layout_below="@+id/url_text"
        android:textAllCaps="false"
        android:layout_alignEnd="@+id/edit_app_name"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"/>
</RelativeLayout>
