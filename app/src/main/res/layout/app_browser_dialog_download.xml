<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:background="@drawable/ui_browser_bg_settings"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="10dp"
    android:elevation="8dp"
    android:paddingVertical="12dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="212dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="14dp"
        android:layout_marginRight="14dp"
        android:layout_marginHorizontal="14dp">
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_muted"
            android:id="@+id/text_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/context_menu_downloads"
            android:layout_weight="1"/>
        <ImageButton
            android:id="@+id/btn_close"
            android:background="@drawable/ui_browser_btn_nav"
            android:padding="7dp"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ui_browser_ic_close"
            android:scaleType="centerInside"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/btn_open_downloads"
        android:background="@drawable/ui_browser_btn_subtle"
        android:paddingLeft="14dp"
        android:paddingTop="8dp"
        android:paddingRight="14dp"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="14dp">
        <TextView
            android:textSize="11.6sp"
            android:textColor="@color/text_default"
            android:ellipsize="end"
            android:id="@+id/text_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_chevron_up_20_filled"
            android:maxWidth="200dp"
            android:text="@string/browser_dialog_downloads_my_title"
            android:maxLines="1"/>
        <TextView
            android:textSize="11.6sp"
            android:gravity="center_vertical"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/browser_dialog_downloads_my_subtitle"
            app:drawableEndCompat="@drawable/ui_browser_ic_open_lnk"/>
    </LinearLayout>
    <ProgressBar
        android:id="@+id/progress_bar"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:layout_marginLeft="14dp"
        android:layout_marginRight="14dp"
        android:indeterminate="true"
        android:progressBackgroundTint="@color/ui_browser_settings_bg"
        android:indeterminateTint="@color/color_primary_blue1"
        android:layout_marginHorizontal="14dp"
        style="?android:attr/progressBarStyleHorizontal"/>
</LinearLayout>
