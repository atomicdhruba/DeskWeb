<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="270dp"
    android:layout_height="wrap_content"
    android:background="@drawable/ui_browser_bg_settings"
    android:elevation="12dp"
    android:orientation="vertical"
    android:paddingStart="2dp"
    android:paddingTop="6dp"
    android:paddingEnd="2dp"
    android:paddingBottom="6dp">

    <ScrollView
        android:id="@+id/settingsScrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/menuContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/btnNewTab"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ui_browser_btn_subtle"
                android:clickable="true"
                android:drawablePadding="14dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="@string/browser_tab_new"
                android:textColor="@color/text_default"
                android:textSize="13sp"
                app:drawableStartCompat="@drawable/ui_browser_ic_new_tab_20" />

            <TextView
                android:id="@+id/btnHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ui_browser_btn_subtle"
                android:clickable="true"
                android:drawablePadding="14dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="@string/browser_menu_history"
                android:textColor="@color/text_default"
                android:textSize="13sp"
                app:drawableStartCompat="@drawable/ui_browser_ic_history_14" />

            <TextView
                android:id="@+id/btnZoom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ui_browser_btn_subtle"
                android:clickable="true"
                android:drawablePadding="14dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="@string/browser_zoom_value"
                android:textColor="@color/text_default"
                android:textSize="13sp"
                app:drawableEndCompat="@drawable/menu_ic_chevron_right_14"
                app:drawableStartCompat="@drawable/ui_browser_ic_zoom_18" />

            <TextView
                android:id="@+id/btnFullscreen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ui_browser_btn_subtle"
                android:clickable="true"
                android:drawablePadding="14dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="@string/browser_menu_fullscreen"
                android:textColor="@color/text_default"
                android:textSize="13sp"
                app:drawableStartCompat="@drawable/ic_fullscreen_24" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="4dp"
                android:background="@color/ui_card_border" />

            <!-- Display & Density -->
            <TextView
                android:id="@+id/btnDensity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ui_browser_btn_subtle"
                android:clickable="true"
                android:drawablePadding="14dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="@string/browser_menu_density"
                android:textColor="@color/text_default"
                android:textSize="13sp"
                app:drawableStartCompat="@drawable/ic_density_24" />

            <TextView
                android:id="@+id/btnOrientation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ui_browser_btn_subtle"
                android:clickable="true"
                android:drawablePadding="14dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="@string/browser_menu_orientation"
                android:textColor="@color/text_default"
                android:textSize="13sp"
                app:drawableStartCompat="@drawable/ui_browser_ic_devices_18" />

            <TextView
                android:id="@+id/btnNavButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ui_browser_btn_subtle"
                android:clickable="true"
                android:drawablePadding="14dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="@string/browser_menu_nav_buttons"
                android:textColor="@color/text_default"
                android:textSize="13sp"
                app:drawableStartCompat="@drawable/ui_browser_ic_nav_left_20" />

            <TextView
                android:id="@+id/btnBookmarksBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ui_browser_btn_subtle"
                android:clickable="true"
                android:drawablePadding="14dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="@string/browser_menu_bookmarks_bar"
                android:textColor="@color/text_default"
                android:textSize="13sp"
                app:drawableStartCompat="@drawable/ic_checkmark_24_filled" />

            <TextView
                android:id="@+id/btnImmersiveMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ui_browser_btn_subtle"
                android:clickable="true"
                android:drawablePadding="14dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="@string/browser_menu_immersive_mode"
                android:textColor="@color/text_default"
                android:textSize="13sp"
                app:drawableStartCompat="@drawable/ic_checkmark_24_filled" />

            <TextView
                android:id="@+id/btnDesktopUA"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ui_browser_btn_subtle"
                android:clickable="true"
                android:drawablePadding="14dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="@string/browser_menu_desktop_site"
                android:textColor="@color/text_default"
                android:textSize="13sp"
                app:drawableStartCompat="@drawable/ui_browser_ic_devices_18" />

            <TextView
                android:id="@+id/btnRestrictKeyboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ui_browser_btn_subtle"
                android:clickable="true"
                android:drawablePadding="14dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="@string/browser_menu_restrict_keyboard"
                android:textColor="@color/text_default"
                android:textSize="13sp"
                app:drawableStartCompat="@drawable/ic_checkmark_24_filled" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="4dp"
                android:background="@color/ui_card_border" />

            <!-- Privacy & Security -->
            <TextView
                android:id="@+id/btnAdBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ui_browser_btn_subtle"
                android:clickable="true"
                android:drawablePadding="14dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="@string/browser_menu_ad_block"
                android:textColor="@color/text_default"
                android:textSize="13sp"
                app:drawableStartCompat="@drawable/ic_shield_24" />

            <TextView
                android:id="@+id/btnHttpsOnly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ui_browser_btn_subtle"
                android:clickable="true"
                android:drawablePadding="14dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="@string/browser_menu_https_only"
                android:textColor="@color/text_default"
                android:textSize="13sp"
                app:drawableStartCompat="@drawable/ic_lock_24" />

            <TextView
                android:id="@+id/btnDnt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ui_browser_btn_subtle"
                android:clickable="true"
                android:drawablePadding="14dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="@string/browser_menu_dnt"
                android:textColor="@color/text_default"
                android:textSize="13sp"
                app:drawableStartCompat="@drawable/ic_checkmark_24_filled" />

            <TextView
                android:id="@+id/btnCookies"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ui_browser_btn_subtle"
                android:clickable="true"
                android:drawablePadding="14dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="@string/browser_menu_cookies"
                android:textColor="@color/text_default"
                android:textSize="13sp"
                app:drawableStartCompat="@drawable/ic_cookie_24" />

            <TextView
                android:id="@+id/btnCertInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ui_browser_btn_subtle"
                android:clickable="true"
                android:drawablePadding="14dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="@string/cert_title"
                android:textColor="@color/text_default"
                android:textSize="13sp"
                app:drawableStartCompat="@drawable/ic_lock_24" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="4dp"
                android:background="@color/ui_card_border" />

            <!-- Tools & Profiles -->
            <TextView
                android:id="@+id/btnSearchEngine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ui_browser_btn_subtle"
                android:clickable="true"
                android:drawablePadding="14dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="@string/browser_menu_search_engine"
                android:textColor="@color/text_default"
                android:textSize="13sp"
                app:drawableStartCompat="@drawable/ui_browser_ic_search_18" />

            <TextView
                android:id="@+id/btnDownloadPath"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ui_browser_btn_subtle"
                android:clickable="true"
                android:drawablePadding="14dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="@string/browser_menu_download_path"
                android:textColor="@color/text_default"
                android:textSize="13sp"
                app:drawableStartCompat="@drawable/ic_folder_24" />

            <TextView
                android:id="@+id/btnScreenshot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ui_browser_btn_subtle"
                android:clickable="true"
                android:drawablePadding="14dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="@string/browser_menu_screenshot"
                android:textColor="@color/text_default"
                android:textSize="13sp"
                app:drawableStartCompat="@drawable/ic_camera_24" />

            <TextView
                android:id="@+id/btnProfiles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ui_browser_btn_subtle"
                android:clickable="true"
                android:drawablePadding="14dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="@string/browser_menu_profiles"
                android:textColor="@color/text_default"
                android:textSize="13sp"
                app:drawableStartCompat="@drawable/ui_browser_ic_history_14" />

            <TextView
                android:id="@+id/btnPrint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ui_browser_btn_subtle"
                android:clickable="true"
                android:drawablePadding="14dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="@string/context_menu_print"
                android:textColor="@color/text_default"
                android:textSize="13sp"
                app:drawableStartCompat="@drawable/ui_browser_ic_print_18" />

            <TextView
                android:id="@+id/btnTranslate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ui_browser_btn_subtle"
                android:clickable="true"
                android:drawablePadding="14dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="@string/browser_ct_menu_translate"
                android:textColor="@color/text_default"
                android:textSize="13sp"
                app:drawableStartCompat="@drawable/ui_browser_ic_translate_18" />

            <TextView
                android:id="@+id/btnSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ui_browser_btn_subtle"
                android:clickable="true"
                android:drawablePadding="14dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="@string/browser_ct_menu_find"
                android:textColor="@color/text_default"
                android:textSize="13sp"
                app:drawableStartCompat="@drawable/ui_browser_ic_search_18" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="4dp"
                android:background="@color/ui_card_border" />

            <TextView
                android:id="@+id/btnAbout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ui_browser_btn_subtle"
                android:clickable="true"
                android:drawablePadding="14dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="@string/browser_ct_menu_about"
                android:textColor="@color/text_default"
                android:textSize="13sp"
                app:drawableStartCompat="@drawable/ui_browser_ic_info_18" />

            <TextView
                android:id="@+id/btnExit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ui_browser_btn_subtle"
                android:clickable="true"
                android:drawablePadding="14dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="@string/browser_ct_menu_exit"
                android:textColor="@color/text_default"
                android:textSize="13sp"
                app:drawableStartCompat="@drawable/ui_browser_ic_exit_18" />
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/zoomContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />
</LinearLayout>
