<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_focused="true"
        android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ui_browser_titlebar_bg"/>
            <corners android:radius="46dp"/>
            <stroke
                android:width="1dp"
                android:color="@color/ui_browser_ui_tint"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_btn_secondary_bg_pressed"/>
            <corners android:radius="46dp"/>
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ui_browser_titlebar_bg"/>
            <corners android:radius="46dp"/>
            <stroke
                android:width="1.8dp"
                android:color="@color/ui_browser_ui_tint"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ui_browser_search_bg"/>
            <corners android:radius="46dp"/>
        </shape>
    </item>
</selector>
